CURRENCY="INR"
JWT_SECRET="your_jwt_secret_key"

# Admin Panel Credentials
ADMIN_EMAIL="admin@vitalsync.com"
ADMIN_PASSWORD="your_admin_password"

# MongoDB Setup (required)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/vitalsync"

# Cloudinary Setup (required for image uploads)
CLOUDINARY_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_SECRET_KEY="your_cloudinary_secret_key"

# Razorpay Payment Integration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Stripe Payment Integration
STRIPE_SECRET_KEY="your_stripe_secret_key"

# Gemini AI Integration (Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key"

# Google Authentication (OAuth 2.0 / Google Identity Services)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:5173, http://localhost:5174
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Payment Test Mode (development only)
# When "true", patients see a "Skip Payment (Test Mode)" button
PAYMENT_TEST_MODE="true"

# ==============================================================================
# Email & Calendar Delivery Setup (Nodemailer)
# ==============================================================================
# When these are NOT set, VitalSync runs in DEV SANDBOX mode using Ethereal fake SMTP.
# Emails in sandbox mode DO NOT arrive in real mailboxes (they are simulated).
#
# OPTION A: Free Gmail (Recommended for testing):
#   1. Turn ON 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"

# OPTION B: Professional SMTP (Brevo / SendGrid / AWS SES):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-key"
# SMTP_FROM="VitalSync Telemedicine <appointments@yourdomain.com>"

# ==============================================================================
# WebRTC TURN Relay Setup (Required for cross-browser / cellular video calls)
# ==============================================================================
# OPTION A (Recommended): Cloudflare Realtime TURN (1,000 GB/month free tier)
# Create a TURN key in Cloudflare Dashboard -> Calls / Realtime -> TURN Keys
# CLOUDFLARE_TURN_KEY_ID="your_cloudflare_turn_key_id"
# CLOUDFLARE_TURN_API_TOKEN="your_cloudflare_turn_api_token"
# CLOUDFLARE_TURN_TTL_SEC="86400"

# OPTION B: Dynamic TURN REST API (e.g. Metered credentials endpoint)
# TURN_API_URL="https://your-app.metered.live/api/v1/turn/credentials?apiKey=your_api_key"

# OPTION C: Self-hosted coturn (ephemeral HMAC secret or static credentials)
# TURN_URLS="turn:turn.yourdomain.com:3478?transport=udp,turns:turn.yourdomain.com:5349?transport=tcp"
# TURN_SECRET="your_coturn_static_auth_secret"
# TURN_USERNAME="your_turn_username"
# TURN_CREDENTIAL="your_turn_credential"

# TURN Free-Tier Quota Guard & Alerting (prevents paid overage charges)
# TURN_MONTHLY_LIMIT_GB="950"      # Default: 950 (Cloudflare 1,000 GB free) or 18 (Metered 20 GB free)
# TURN_WARN_PERCENT="80"           # One-time warning email + doctor/admin socket alert
# TURN_HARD_STOP_PERCENT="95"      # Circuit breaker: stops issuing TURN (STUN-only) + critical email
# TURN_ALERT_EMAIL="alerts@yourdomain.com"  # Falls back to ADMIN_EMAIL / EMAIL_USER / SMTP_USER
